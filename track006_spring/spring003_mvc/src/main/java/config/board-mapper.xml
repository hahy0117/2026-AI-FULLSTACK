<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.the703.dao.BoardMapper">



	<insert id="insert" parameterType="BoardDto">
		insert into mvcboard2 (bname,bpass,btitle,bcontext,bip,bfile)
		values(#{bname},#{bpass},#{btitle},#{bcontext},#{bip},#{bfile})
	</insert>

	<update id="update" parameterType="BoardDto">
		update mvcboard2 set btitle=#{btitle}, bcontext=#{bcontext},bfile=#{bfile} where bno=#{bno} 
	</update>

	<delete id="delete" parameterType="int">
		delete from mvcboard2 where bno=#{bno}
	</delete>

	<select resultType="BoardDto" id="selectAll">
		select * from mvcboard2 order by bno desc
	</select>

	<select resultType="BoardDto" id="select" parameterType="int">
		select * from mvcboard2 where bno=#{bno}
	</select>

	<select resultType="BoardDto" id="detail" parameterType="int">
		select * from mvcboard2 where bno=#{bno}
	</select>
	
	<update id="updateHit" parameterType="int">
	update mvcboard2 set bhit=bhit+1 where bno=#{bno}
	</update>
	
	<!-- paging -->
	<!-- paging -->
	
	<select resultType="BoardDto" id="select10" parameterType="java.util.HashMap">
	select*from mvcboard2 order by bno desc limit #{start},#{end}
	</select>
	
	<select resultType="int" id="selectCnt" >
	select count(*) from mvcboard2
	</select>
	

</mapper>