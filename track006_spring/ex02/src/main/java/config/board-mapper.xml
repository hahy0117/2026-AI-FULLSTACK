<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.the703.dao.BoardMapper">

  
  
  <insert id="insert" parameterType="BoardDto">
    insert into mvcboard2 (bname,bpass,btitle,bcontent,bhip) 
    values(#{bname},#{bpass},#{btitle},#{bcontent},#{bhip})
  </insert>
  
  <update id="update" parameterType="BoardDto">
  update mvcboard2 set btitle=#{btitle}, bcontext=#{bcontext} where bno=#{bno}
  </update>
  
  <delete id="delete" parameterType="int">
  delete from mvcboard2 where bno=#{bno}
  </delete>
  
  <select  resultType="BoardDto" id="selectAll" >
    select * from  mvcboard2 order by desc
  </select>
  
  <select  resultType="BoardDto" id="select" parameterType="int">
    select * from  mvcboard2 where bno=#{bno}
  </select>
  
</mapper>